<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChatRelay.ShareTarget</AssemblyName>
    <RootNamespace>ChatRelay.ShareTarget</RootNamespace>
    <!-- The <msix> element in this manifest gives the unpackaged exe the sparse
         package's identity, which is what lets Windows activate it as a share target. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
